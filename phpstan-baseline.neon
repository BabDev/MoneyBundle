		-
			message: '#^Property BabDev\\MoneyBundle\\Validator\\Constraints\\AbstractMoneyComparison\:\:\$value \(float\|int\|Money\\Money\|numeric\-string\|null\) does not accept mixed\.$#'
			identifier: assign.propertyType
			count: 1
